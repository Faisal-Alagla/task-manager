# === Postgres DB ===
POSTGRES_DB: task-manager
POSTGRES_USER: postgres
POSTGRES_PASSWORD: postgres

# === Service ===
ENV: dev

# DB connection
DB_URL: jdbc:postgresql://task-db:5432/task-manager
DB_USERNAME: postgres
DB_PASSWORD: postgres

# Swagger
OPENAPI_DEV_URL: http://localhost:8080}
OPENAPI_PROD_URL: http://localhost:8080}

# === Messaging ===
MESSAGING_ENABLED: true
MESSAGING_EXCHANGE: domain.events
MESSAGING_DLX: domain.events.dlx
MESSAGING_PUBLISH_MANDATORY: true
MESSAGING_CONSUMER_CONCURRENCY: 2
MESSAGING_CONSUMER_MAX_ATTEMPTS: 5
MESSAGING_CONSUMER_PREFETCH: 20
MESSAGING_REQUEUE_REJECTED: false
RABBITMQ_HOST: rabbitmq
RABBITMQ_PORT: 5672
RABBITMQ_USERNAME: rabbitmq
RABBITMQ_PASSWORD: rabbitmq
RABBITMQ_VHOST: /
